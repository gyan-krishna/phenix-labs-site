# Public website URL, without a trailing slash
NEXT_PUBLIC_BASE_URL=https://www.example.com

# Optional Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# Sanity project settings from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version in YYYY-MM-DD format
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Careers application security (configure these in Netlify, never expose in the browser)
# Use a random value of at least 32 characters.
APPLICATION_DEDUP_SECRET=replace_with_a_long_random_secret

# Netlify Project ID and a least-privilege personal access token used only by daily retention cleanup.
NETLIFY_SITE_ID=your_netlify_project_id
NETLIFY_ACCESS_TOKEN=your_limited_scope_netlify_access_token
# Set true to inspect cleanup eligibility without deleting submissions. Set false for production cleanup.
APPLICATION_CLEANUP_DRY_RUN=false

# Resend confirmation-email delivery. The sender must use a verified Resend domain.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Phenix Labs Careers <careers@example.com>
CAREERS_REPLY_TO_EMAIL=careers@example.com
